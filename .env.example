# Copy to admin/.env (and/or pipeline/.env). NEVER commit the real file.
# Values come from Supabase dashboard -> Project Settings -> API.

SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key: admin app and pipeline ONLY. Bypasses RLS.
# Never put it in web/, Edge Functions, or git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional (Phase 4 preview): call YouVersion directly from the admin app.
# The Edge Function gets its own copy via `supabase secrets set`.
YOUVERSION_API_KEY=

# Pipeline settings
OPENHYMNAL_DIR=~/openhymnal
MP3_BITRATE_KBPS=96
