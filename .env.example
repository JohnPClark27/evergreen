# Copy to .env in the repo root. NEVER commit the real file.
# Values come from Supabase dashboard -> Project Settings -> API.

SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key: pipeline scripts ONLY (importers, seeds, tests). Bypasses RLS.
# Never put it in web/ (the Studio uses sign-in, not this key), Edge Functions, or git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: not used by the Studio (it previews through the Edge Function).
# The Edge Function gets its own copy via `supabase secrets set`.
YOUVERSION_API_KEY=

# Pipeline settings
OPENHYMNAL_DIR=~/openhymnal
MP3_BITRATE_KBPS=96
