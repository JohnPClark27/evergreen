/* style.qss - the admin app's one stylesheet.
   @tokens are filled in by theme.py with the light or dark palette (follows the system). */

QWidget {
    font-size: 14px;
    color: @ink;
}
QMainWindow, QDialog, #page { background: @bg; }

/* ---- Left navigation ---- */
#navBox { background: @surface; border-right: 1px solid @border; }
#nav { background: transparent; border: none; outline: 0; padding-top: 4px; }
#nav::item {
    padding: 10px 18px;
    margin: 2px 8px;
    border-radius: 6px;
    color: @muted;
}
#nav::item:hover { background: @accent_soft; color: @ink; }
#nav::item:selected { background: @accent; color: @on_accent; }
#appTitle { font-size: 16px; font-weight: 600; padding: 16px 18px 6px 18px; color: @accent_text; }

/* ---- Headings and text ---- */
#pageTitle { font-size: 22px; font-weight: 600; }
#sectionTitle { font-size: 15px; font-weight: 600; margin-top: 6px; }
#muted, .muted { color: @muted; }
#error { color: @danger; }

/* ---- Cards ---- */
#card {
    background: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
#bigNumber { font-size: 28px; font-weight: 600; color: @accent_text; }

/* ---- Inputs ---- */
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox {
    background: @surface;
    border: 1px solid @border_strong;
    border-radius: 6px;
    padding: 5px 7px;
    selection-background-color: @highlight;
    selection-color: @ink;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid @accent; }
QLineEdit[invalid="true"], QPlainTextEdit[invalid="true"] { border: 2px solid @danger; }
QLineEdit:read-only, QPlainTextEdit[readOnly="true"] { background: @bg; }

/* ---- Buttons ---- */
QPushButton {
    background: @surface;
    border: 1px solid @border_strong;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover { background: @accent_soft; }
QPushButton:disabled { color: @muted; background: @bg; }
QPushButton#primary {
    background: @accent;
    color: @on_accent;
    border: 1px solid @accent;
    font-weight: 600;
}
QPushButton#primary:hover { background: @accent_hover; }
QPushButton#primary:disabled { background: @border; border-color: @border; color: @muted; }
QPushButton#link {
    border: none; background: transparent; color: @accent_text;
    text-align: left; padding: 3px 0;
}
QPushButton#link:hover { text-decoration: underline; }

/* ---- Tables and lists ---- */
QTableView, QTableWidget, QListWidget {
    background: @surface;
    alternate-background-color: @bg;
    border: 1px solid @border;
    border-radius: 6px;
    gridline-color: @border;
    selection-background-color: @highlight;
    selection-color: @ink;
}
QHeaderView::section {
    background: @bg;
    border: none;
    border-bottom: 1px solid @border_strong;
    padding: 6px;
    font-weight: 600;
}
QListWidget::item { padding: 5px; }

QProgressBar {
    border: 1px solid @border_strong;
    border-radius: 5px;
    background: @bg;
    text-align: center;
    height: 16px;
}
QProgressBar::chunk { background: @accent; border-radius: 4px; }

QScrollArea { border: none; background: transparent; }
QSplitter::handle { background: @border; width: 1px; }
QStatusBar { background: @surface; border-top: 1px solid @border; }
QToolTip { background: @surface; color: @ink; border: 1px solid @border_strong; }
